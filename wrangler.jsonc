// The web build on Cloudflare Workers static assets: no Worker script, just `dist/` (bun run build).
// Every route is the app's shell, so a page that isn't a file gets index.html with 200.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fryday",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
