// Fryday: Fry's insulin and amlodipine, with a double-dose guard. The same app as the Rune
// reference (mfunkie/fryday). This root owns what only a root may: the route, the data
// (`loadBoard`, `giveDose`, `undoLast` in app.ts), the timers and the actions. Everything it
// draws is a component in ui/, each a file with its own props; colours are app.tamber's.
use Board, Reply, Time, Viewport from "./ui/shapes.contract"
use Backdrop from "./ui/backdrop.contract"
use Header from "./ui/header.contract"
use Orb from "./ui/orb.contract"
use StreakCard from "./ui/streak.contract"
use Today from "./ui/today.contract"

routes nav
  home "/"

component Fryday
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  state now = 0
  state who = 0 persist
  state pendingKey = ""
  state tapped = ""
  state burstKey = ""
  state notice = ""
  derive scene = searchParam(top(nav), "scene")
  derive shown = time.epochAtZero + now
  resource board = loadBoard(scene, time.utcOffset, pendingKey) with shown as shape Board
  mutation given as shape Reply queue refreshes board then afterGive
  mutation undone as shape Reply queue refreshes board then afterUndo
  derive outcome = match given { case some(r) => r.outcome, case none => "" }
  derive refusal = match given { case some(r) => r.notice, case none => "" }
  derive wide = viewport.width >= 820
  derive still = viewport.prefersReducedMotion
  // A kept choice is read back as stored, and a store can hold anything (verify boots from one
  // holding 123.456): an index that isn't a caregiver's is the first caregiver.
  derive me = (who >= 0 and floor(who) == who and who < board.caregivers.length) ? who : 0
  derive caregiver = match board.caregivers.at(me) { case some(n) => n, case none => "You" }

  task tick mount
    every(30000, step)
  task fade when burstKey != "" key=burstKey
    after(2200, clearBurst)

  action step
    now = performanceNow()
  action follow(url: string)
    nav = go(nav, url)
  action setWho(i: number)
    who = i
  // A tap on Give. The first tap inside the guard hours comes back `tooSoon` and the card asks;
  // a second tap on the same card sends the override.
  action give(key: string, med: string, slot: string, day: string)
    let at = time.epochAtZero + performanceNow()
    now = performanceNow()
    tapped = key
    notice = ""
    send given = giveDose(scene, med, slot, day, at, time.utcOffset, caregiver, pendingKey == key)
  action afterGive
    if outcome == "tooSoon"
      pendingKey = tapped
    else if outcome == "logged"
      pendingKey = ""
      burstKey = tapped
    else
      pendingKey = ""
      notice = refusal
  action cancel
    pendingKey = ""
  action undo
    pendingKey = ""
    send undone = undoLast(scene)
  action afterUndo
    burstKey = ""
  action clearBurst
    burstKey = ""

  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      color-scheme="dark" background-color="ink" color="text"
      Backdrop(late=board.late, still=still)
      scroll id="content" position="absolute" inset=0
        column padding=(wide ? 32 : 20) gap=24 max-width=(wide ? "920px" : "480px") margin-left="auto" margin-right="auto"
          Header(dateLine=board.dateLine, caregivers=board.caregivers, who=me, pick=setWho)
          // The orb and streak beside today's cards when wide; stacked on a phone.
          row flex-wrap="wrap" gap=28 align-items="flex-start"
            column flex="1 1 300px" align-items="center" gap=14 max-width=(wide ? "340px" : "100%") testId="hero"
              Orb(face=board.face, wide=wide, still=still)
              StreakCard(streak=board.streak, dots=board.dots)
            Today(cards=board.cards, undoLabel=board.undo, notice=notice, burstKey=burstKey, caregiver=caregiver, still=still, give=give, cancel=cancel, undo=undo)
